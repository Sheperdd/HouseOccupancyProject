/*
 * secrets.h.example -- template for the real secrets.h (which is GITIGNORED).
 *
 * Setup: copy this file to secrets.h (same folder) and fill in real values.
 * secrets.h never gets committed -- credentials in git history are forever,
 * even after deletion.
 */
#ifndef NET_SECRETS_H
#define NET_SECRETS_H

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"

/* Broker URI: the Pi 5's reserved IP, standard MQTT port. */
#define MQTT_URI  "mqtt://192.168.1.50:1883"
#define MQTT_USER "doorway-node-01"
#define MQTT_PASS "your-mosquitto-password"

#endif /* NET_SECRETS_H */
