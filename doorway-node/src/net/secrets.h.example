/*
 * secrets.h.example -- template for the real secrets.h (which is GITIGNORED).
 *
 * Setup: copy this file to secrets.h (same folder) and fill in real values.
 * secrets.h never gets committed -- credentials in git history are forever,
 * even after deletion.
 *
 * ONE secrets.h covers every node: the building env's node_config_XX.h
 * defines NODE_NUM, which selects that node's broker password below.
 */
#ifndef NET_SECRETS_H
#define NET_SECRETS_H

#include "node_config.h" /* NODE_ID + NODE_NUM select this node's creds */

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"

/* Broker URI: the Pi 5's reserved IP, standard MQTT port. */
#define MQTT_URI "mqtt://192.168.1.50:1883"

/* Broker username == NODE_ID by convention (one mosquitto user per node). */
#define MQTT_USER NODE_ID

#if NODE_NUM == 1
#define MQTT_PASS "node01-mosquitto-password"
#elif NODE_NUM == 2
#define MQTT_PASS "node02-mosquitto-password"
#else
#error "no broker password for this NODE_NUM -- add a branch above"
#endif

/* Optional: NTP server for clock sync (Phase 4). Defaults to pool.ntp.org in
 * net.c; uncomment to point at a LAN time server (e.g. chrony on the Pi 5)
 * so the nodes stay synced even when the internet is down. */
// #define NTP_SERVER "192.168.1.50"

#endif /* NET_SECRETS_H */
